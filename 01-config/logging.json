{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "echo_formatter": {
            "format": "%(asctime)s - %(levelname)s - %(message)s",
            "datefmt": "%Y-%m-%dT%H:%M:%S%z"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "echo_formatter",
            "stream": "ext://sys.stdout"
        }
    },
    "loggers": {
        "uvicorn": {
            "handlers": ["console"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.access": {
            "handlers": ["console"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.error": {
            "handlers": ["console"],
            "level": "INFO",
            "propagate": false
        },
        "werkzeug": {
            "handlers": ["console"],
            "level": "INFO",
            "propagate": false
        }
    },
    "root": {
        "level": "INFO",
        "handlers": ["console"]
    }
}
