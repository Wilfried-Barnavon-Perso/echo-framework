# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{sh,py}]
charset = utf-8
indent_style = space
indent_size = 4

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 2