# ==============================================================================
# GIT ATTRIBUTES - ECHO FRAMEWORK
#
# Force LF line endings for scripts to prevent Windows CRLF issues in Linux VM
# ==============================================================================

# Scripts Bash & Python : Toujours en LF
*.sh text eol=lf
*.py text eol=lf

# Configs & Documentation
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
Dockerfile text eol=lf
requirements.txt text eol=lf

# Le fichier VERSION doit être strict
VERSION text eol=lf
16-docker-echo-webui/UI_VERSION text eol=lf

# Artefacts d'encryption (checksums SHA-256 stricts sur LF hors binaire WASM)
16-docker-echo-webui/src/lib/encryption/** text eol=lf

# PowerShell force CRLF (Windows Native)
*.ps1 text eol=crlf

# Images & Binaires
*.png binary
*.jpg binary
*.ico binary
*.wasm binary